{
  "name": "@liangstech/agent-mem",
  "version": "0.1.0",
  "description": "Visually manage, share and hand off memories between coding agents (Claude Code, Codex, Pi, ...)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-mem": "./dist/index.js"
  },
  "files": [
    "dist",
    "web-dist",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm --dir ../.. build && pnpm --dir ../.. test:package"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "diff": "^8.0.4",
    "@hono/node-server": "^1.19.0",
    "chokidar": "^4.0.3",
    "hono": "^4.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RCliang/agent-mem-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/RCliang/agent-mem-workspace/issues"
  },
  "keywords": [
    "agent",
    "memory",
    "claude-code",
    "codex",
    "cli",
    "coding-agents",
    "skills",
    "handoff"
  ],
  "homepage": "https://github.com/RCliang/agent-mem-workspace#readme",
  "devDependencies": {
    "@agent-mem/core": "workspace:*",
    "@agent-mem/server": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
