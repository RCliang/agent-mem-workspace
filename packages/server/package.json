{
  "name": "@agent-mem/server",
  "version": "0.1.0",
  "description": "Local HTTP server for Agent Memory Hub",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
