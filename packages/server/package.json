  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-mem/core": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "chokidar": "^4.0.3",
