{
  "name": "agent-mem-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "typecheck": "pnpm --filter @agent-mem/core --filter @agent-mem/server run build && pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:web": "pnpm --filter @agent-mem/web run dev",
    "ui": "node packages/cli/dist/index.js ui",
    "test:package": "node --test scripts/package.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
